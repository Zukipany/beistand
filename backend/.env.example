# Copy to .env and fill in. Every key is optional; a missing key switches that feature to an offline or dry-run mode.
# Settings → Diagnostics in the app shows which features are live.

# Claude: Read this, scam check, "What's in front of me?", magnifier "Explain".
# Get it at https://platform.claude.com (API keys). Paid per use.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Gemini: the live camera guide (and photo answers when there is no Claude key).
# Get it at https://aistudio.google.com/apikey. Check model names on the Models page.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VISION_MODEL=gemini-2.5-flash

# Twilio: real calls and text messages to the emergency contact (otherwise shown in /outbox).
# Get it at https://console.twilio.com. Trial accounts can only call verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: OpenRouteService routes (Valhalla is used without it).
ORS_API_KEY=
# Optional: your own Valhalla server instead of the public OpenStreetMap one.
VALHALLA_URL=https://valhalla1.openstreetmap.de

# DB API Marketplace: lift status at stations (https://developers.deutschebahn.com, FaSta API).
DB_CLIENT_ID=
DB_API_KEY=

# The address contacts open from the SMS (use an ngrok or Cloudflare tunnel during the demo).
PUBLIC_BASE_URL=http://localhost:8000
ASK_TIMEOUT_S=30
CONTACT_RETRY_S=120
